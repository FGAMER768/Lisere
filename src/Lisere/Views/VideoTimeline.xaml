<UserControl x:Class="Lisere.Views.VideoTimeline"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root"
             Height="64"
             Focusable="True"
             KeyDown="OnTimelineKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,2">
            <TextBlock x:Name="CurrentTimeText"
                       VerticalAlignment="Center"
                       FontFamily="Consolas"
                       FontSize="11"
                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                       Text="0:00.0" />
            <TextBlock x:Name="TotalTimeText"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontFamily="Consolas"
                       FontSize="11"
                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                       Text="0:00" />
        </Grid>

        <Grid x:Name="TrackHost"
              Grid.Row="1"
              Margin="0,6,0,0"
              Background="Transparent"
              ClipToBounds="True"
              Cursor="Hand"
              LostMouseCapture="OnTrackLostMouseCapture"
              MouseEnter="OnTrackMouseEnter"
              MouseLeave="OnTrackMouseLeave"
              MouseLeftButtonDown="OnTrackMouseLeftButtonDown"
              MouseLeftButtonUp="OnTrackMouseLeftButtonUp"
              MouseMove="OnTrackMouseMove"
              SizeChanged="OnTrackSizeChanged">
            <Border x:Name="TrackBackground"
                    Height="18"
                    Margin="0,0,0,2"
                    VerticalAlignment="Bottom"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    CornerRadius="4" />
            <Border x:Name="ProgressFill"
                    Height="18"
                    Margin="0,0,0,2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                    CornerRadius="4" />

            <Canvas x:Name="TickCanvas"
                    ClipToBounds="True"
                    IsHitTestVisible="False" />

            <!-- Ghost playhead: follows the pointer, while the real playhead
                 only moves on click or drag. -->
            <Border x:Name="HoverPlayhead"
                    Width="1"
                    Margin="0,15,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    AutomationProperties.AutomationId="TimelineHoverPlayhead"
                    Background="#B3F2F2F2"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" />

            <Border x:Name="Playhead"
                    Width="2"
                    Margin="0,15,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    Background="{ui:ThemeResource AccentTextFillColorPrimaryBrush}"
                    IsHitTestVisible="False" />
            <Border x:Name="PlayheadGrip"
                    Width="10"
                    Height="10"
                    Margin="0,15,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="{ui:ThemeResource AccentTextFillColorPrimaryBrush}"
                    BorderBrush="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                    BorderThickness="2"
                    CornerRadius="5"
                    IsHitTestVisible="False" />
        </Grid>
    </Grid>
</UserControl>
