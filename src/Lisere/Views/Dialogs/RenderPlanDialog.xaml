<UserControl x:Class="Lisere.Views.Dialogs.RenderPlanDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:Lisere.Views"
             x:Name="Root"
             Focusable="True"
             FocusManager.IsFocusScope="True"
             KeyboardNavigation.TabNavigation="Cycle">

    <UserControl.Resources>
        <!-- The primary button fills its own border, so keyboard focus needs a
             dedicated outline that stays visible on the blue surface. -->
        <Style x:Key="DialogFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-3"
                                   RadiusX="6"
                                   RadiusY="6"
                                   SnapsToDevicePixels="True"
                                   Stroke="#FFFFFFFF"
                                   StrokeThickness="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Background="#99000000">
        <Border x:Name="DialogCard"
                MinWidth="760"
                MaxWidth="900"
                Margin="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#FF272727"
                BorderBrush="#FF3A3A3A"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="24,24,24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Grid.Column="0"
                                   VerticalAlignment="Top"
                                   FontSize="18"
                                   Foreground="#FFD0D0D0"
                                   Symbol="Video24" />
                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="TitleText"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#FFE6E6E6"
                                   Text="Préparer le rendu" />
                        <TextBlock x:Name="IntroText"
                                   Margin="0,4,0,0"
                                   FontSize="13"
                                   Foreground="#FFB4B4B4"
                                   Text="Vérifiez la source et le résultat avant de lancer le rendu."
                                   TextWrapping="Wrap" />
                        <Border x:Name="ReassurancePanel"
                                Margin="0,10,0,0"
                                Padding="10,8"
                                Background="#1AFFFFFF"
                                CornerRadius="4"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0"
                                               VerticalAlignment="Top"
                                               FontSize="14"
                                               Foreground="#FFB4B4B4"
                                               Symbol="Info24" />
                                <TextBlock x:Name="ReassuranceText"
                                           Grid.Column="2"
                                           FontSize="12"
                                           Foreground="#FFD0D0D0"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="24,16,24,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Height="280"
                            Background="#FF1B1B1B"
                            BorderBrush="#FF3A3A3A"
                            BorderThickness="1"
                            CornerRadius="6"
                            ClipToBounds="True">
                        <views:BeforeAfterView x:Name="Comparison" />
                    </Border>

                    <ScrollViewer Grid.Column="2"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="SourceLabelText"
                                       FontSize="12"
                                       Foreground="#FFB4B4B4"
                                       Text="Source"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="SourceText"
                                       Margin="0,4,0,0"
                                       FontSize="13"
                                       Foreground="#FFE6E6E6"
                                       TextWrapping="Wrap" />

                            <Border Height="1"
                                    Margin="0,14"
                                    Background="#FF3A3A3A" />

                            <ItemsControl x:Name="LinesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,12">
                                            <TextBlock FontSize="12"
                                                       Foreground="#FFB4B4B4"
                                                       Text="{Binding Label}" />
                                            <TextBlock Margin="0,3,0,0"
                                                       FontSize="13"
                                                       Foreground="#FFE6E6E6"
                                                       Text="{Binding Value}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="DestinationLabelText"
                                       FontSize="12"
                                       Foreground="#FFB4B4B4"
                                       Text="Destination" />
                            <TextBlock x:Name="DestinationText"
                                       Margin="0,4,0,0"
                                       FontSize="13"
                                       Foreground="#FFE6E6E6"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Border Grid.Row="2"
                        Background="#50000000"
                        CornerRadius="0,0,8,8"
                        ClipToBounds="True">
                    <Grid Margin="24,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:Button x:Name="CancelButton"
                                   Grid.Column="1"
                                   MinWidth="112"
                                   MinHeight="36"
                                   Click="OnCancelClick"
                                   Content="Annuler"
                                   FocusVisualStyle="{StaticResource DialogFocusVisual}" />
                        <ui:Button x:Name="ConfirmButton"
                                   Grid.Column="3"
                                   MinWidth="150"
                                   MinHeight="36"
                                   Appearance="Primary"
                                   Click="OnConfirmClick"
                                   Content="Lancer le rendu"
                                   FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                   Icon="{ui:SymbolIcon Save24}"
                                   IsDefault="True" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
