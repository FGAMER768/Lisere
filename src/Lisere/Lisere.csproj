<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Lisere</AssemblyName>
    <RootNamespace>Lisere</RootNamespace>
    <ApplicationIcon>..\..\assets\Lisere.ico</ApplicationIcon>
    <Version>1.4.0</Version>
    <Authors>FGAMER768</Authors>
    <Company>FGAMER768</Company>
    <Product>Liseré</Product>
    <Description>Amélioration d'images et de vidéos, colorimétrie et rendu local.</Description>
    <Copyright>Copyright © 2026 FGAMER768</Copyright>
    <!-- Rendu vidéo long : le pool supprime les allocations par frame, ces
         réglages empêchent le GC de retenir les segments du LOH et rendent la
         mémoire au système quand le rendu retombe. -->
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lisere.Core\Lisere.Core.csproj" />
    <ProjectReference Include="..\Lisere.Ai\Lisere.Ai.csproj" />
    <ProjectReference Include="..\Lisere.Video\Lisere.Video.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\Lisere.ico" Link="Assets\Lisere.ico" />
    <Resource Include="..\..\assets\LisereIcon.png" Link="Assets\LisereIcon.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\models\catalog.json" Link="models\catalog.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\models\README.md" Link="models\README.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\models\onnx\*.onnx" Link="models\onnx\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\models\onnx\LICENSE*" Link="models\onnx\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\models\rife\LICENSE" Link="models\rife\LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\models\yunet\LICENSE" Link="models\yunet\LICENSE" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\tools\ffmpeg\ffmpeg.exe')">
    <Content Include="..\..\tools\ffmpeg\*.*"
             Link="ffmpeg\%(Filename)%(Extension)"
             ExcludeFromSingleFile="true"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\ffmpeg\manifest.json"
             Link="ffmpeg\manifest.json"
             ExcludeFromSingleFile="true"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\ffmpeg\LICENSE.txt"
             Link="ffmpeg\LICENSE.txt"
             ExcludeFromSingleFile="true"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="RequireBundledFfmpeg"
          BeforeTargets="Publish"
          Condition="!Exists('..\..\tools\ffmpeg\ffmpeg.exe')">
    <Error Text="Le paquet FFmpeg intégré est absent. Lancez scripts/fetch-ffmpeg.ps1 avant de publier Lisere." />
  </Target>

</Project>
