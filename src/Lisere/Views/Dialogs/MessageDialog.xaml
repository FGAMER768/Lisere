<UserControl x:Class="Lisere.Views.Dialogs.MessageDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root"
             Focusable="True"
             FocusManager.IsFocusScope="True"
             KeyboardNavigation.TabNavigation="Cycle"
             PreviewKeyDown="OnPreviewKeyDown">

    <Grid x:Name="RootGrid" Background="#99000000">
        <Border x:Name="DialogCard"
                MinWidth="360"
                MaxWidth="480"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#FF272727"
                BorderBrush="#FF3A3A3A"
                BorderThickness="1"
                CornerRadius="8"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="24,24,24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon x:Name="TitleIcon"
                                   Grid.Column="0"
                                   Symbol="Info16"
                                   Foreground="#FFD0D0D0"
                                   FontSize="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    <TextBlock x:Name="TitleText"
                               Grid.Column="2"
                               Text="Information"
                               Foreground="#FFD0D0D0"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </Grid>

                <Grid Grid.Row="1"
                      MinHeight="64"
                      Margin="24,18,24,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon x:Name="BodyIcon"
                                   Grid.Column="0"
                                   Symbol="Info24"
                                   Foreground="#FFE6E6E6"
                                   FontSize="26"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    <TextBlock x:Name="MessageText"
                               Grid.Column="2"
                               AutomationProperties.LiveSetting="Assertive"
                               Foreground="#FFE6E6E6"
                               FontSize="14"
                               Text="Message"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                </Grid>

                <Border x:Name="FooterBorder"
                        Grid.Row="2"
                        Background="#50000000"
                        CornerRadius="0,0,8,8"
                        ClipToBounds="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="12" />
                            <RowDefinition Height="44" />
                            <RowDefinition Height="12" />
                        </Grid.RowDefinitions>
                        <ui:Button x:Name="OkButton"
                                   Grid.Column="1"
                                   Grid.Row="1"
                                   HorizontalAlignment="Stretch"
                                   AutomationProperties.AcceleratorKey="Entrée"
                                   Appearance="Primary"
                                   Click="OkButton_Click"
                                   Content="OK"
                                   Icon="{ui:SymbolIcon Checkmark16}"
                                   IsDefault="True" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
