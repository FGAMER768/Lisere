<UserControl x:Class="Lisere.Views.BeforeAfterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             AutomationProperties.Name="{Binding Localization[beforeAfterComparison], RelativeSource={RelativeSource Self}}"
             KeyDown="OnStageKeyDown"
             x:Name="Root">
    <UserControl.Resources>
        <!-- The preview uses a dark glass surface. A dedicated opaque tooltip
             avoids the underlying image text showing through the popup. -->
        <Style TargetType="ToolTip">
            <Setter Property="MaxWidth" Value="300" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Background" Value="#FF202020" />
            <Setter Property="Foreground" Value="#FFF2F2F2" />
            <Setter Property="BorderBrush" Value="#40FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The zoom pill keeps its own dark surface, so its buttons must not
             inherit the light/dark theme hover brushes: white on white would
             disappear in light mode. -->
        <Style x:Key="ZoomButton" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#FFF2F2F2" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="200" />
            <Setter Property="ToolTipService.ShowDuration" Value="8000" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#4DFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FF60CDFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PreviewModeButton" TargetType="RadioButton">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="200" />
            <Setter Property="ToolTipService.Placement" Value="Top" />
            <Setter Property="ToolTipService.ShowDuration" Value="8000" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#4D60CDFF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#4DFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FF60CDFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="Stage"
              Background="{ui:ThemeResource ControlFillColorDefaultBrush}"
              ClipToBounds="True"
              Focusable="True"
              AutomationProperties.HelpText="{Binding Localization[beforeAfterComparisonHelp], ElementName=Root}"
              MouseLeftButtonDown="OnStageMouseLeftButtonDown"
              MouseLeftButtonUp="OnStageMouseLeftButtonUp"
              MouseMove="OnStageMouseMove"
              PreviewMouseWheel="OnStageMouseWheel"
              SizeChanged="OnStageSizeChanged">

            <!-- One transformed host carries both layers, so a zoom applies to
                 the before and after images at the same time. Scaling about the
                 centre keeps the viewport centre fixed, which is what makes the
                 wheel zoom feel anchored instead of drifting. -->
            <Grid x:Name="ZoomHost"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  RenderTransformOrigin="0.5,0.5"
                  ClipToBounds="True">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="ZoomScale" ScaleX="1" ScaleY="1" />
                        <TranslateTransform x:Name="ZoomTranslate" X="0" Y="0" />
                    </TransformGroup>
                </Grid.RenderTransform>

                <Grid x:Name="ImageLayer" ClipToBounds="True">
                    <Image x:Name="AfterLayerImage"
                           AutomationProperties.Name="{Binding Localization[beforeAfterAfterPreview], ElementName=Root}"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Source="{Binding AfterImage, ElementName=Root}"
                           Stretch="UniformToFill" />

                    <Grid x:Name="BeforeLayer"
                          HorizontalAlignment="Left"
                          ClipToBounds="True">
                        <Image x:Name="BeforeLayerImage"
                               Width="{Binding ActualWidth, ElementName=ImageLayer}"
                               Height="{Binding ActualHeight, ElementName=ImageLayer}"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               AutomationProperties.Name="{Binding Localization[beforeAfterBeforePreview], ElementName=Root}"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Source="{Binding BeforeImage, ElementName=Root}"
                               Stretch="UniformToFill" />
                    </Grid>
                </Grid>

                <!-- Chaque moitié est un cadre clippé qui reçoit le même zoom et
                     le même déplacement : les deux images montrent donc toujours
                     exactement la même région, de part et d'autre du trait. -->
                <Grid x:Name="SideBySideLayer" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" ClipToBounds="True">
                        <Image x:Name="SideBySideBeforeImage"
                               AutomationProperties.Name="{Binding Localization[beforeAfterBeforePreview], ElementName=Root}"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               RenderTransformOrigin="0.5,0.5"
                               Source="{Binding BeforeImage, ElementName=Root}"
                               Stretch="Uniform">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="SideBeforeScale" ScaleX="1" ScaleY="1" />
                                    <TranslateTransform x:Name="SideBeforeTranslate" X="0" Y="0" />
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>
                    </Grid>
                    <Grid Grid.Column="1" ClipToBounds="True">
                        <Image x:Name="SideBySideAfterImage"
                               AutomationProperties.Name="{Binding Localization[beforeAfterAfterPreview], ElementName=Root}"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               RenderTransformOrigin="0.5,0.5"
                               Source="{Binding AfterImage, ElementName=Root}"
                               Stretch="Uniform">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="SideAfterScale" ScaleX="1" ScaleY="1" />
                                    <TranslateTransform x:Name="SideAfterTranslate" X="0" Y="0" />
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>
                    </Grid>
                </Grid>
            </Grid>

            <!-- The guide lives in stage space, not inside the zoom transform:
                 it keeps a constant thickness and a constant-size grip at any
                 zoom level, and follows the transformed content position. -->
            <Border x:Name="Divider"
                    Width="2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="#FFF7F7F7"
                    IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="4"
                                      Color="#FF000000"
                                      Opacity="0.8"
                                      ShadowDepth="0" />
                </Border.Effect>
            </Border>

            <Thumb x:Name="DividerThumb"
                   Width="28"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   AutomationProperties.HelpText="{Binding Localization[beforeAfterComparisonArrowsHelp], ElementName=Root}"
                   AutomationProperties.Name="{Binding Localization[beforeAfterComparisonPosition], ElementName=Root}"
                   Background="Transparent"
                   Cursor="SizeWE"
                   DragDelta="OnDividerDragDelta"
                   Focusable="True"
                   IsTabStop="True"
                   KeyDown="OnDividerKeyDown">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Border x:Name="GripBorder"
                                    Width="20"
                                    Height="40"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#F21B1B1B"
                                    BorderBrush="#FFFFFFFF"
                                    BorderThickness="1.5"
                                    CornerRadius="10">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="6"
                                                      Color="#FF000000"
                                                      Opacity="0.6"
                                                      ShadowDepth="1" />
                                </Border.Effect>
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                    <Border Width="2"
                                            Height="12"
                                            Margin="0,0,3,0"
                                            Background="#FFFFFFFF" />
                                    <Border Width="2"
                                            Height="12"
                                            Background="#FFFFFFFF" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="GripBorder"
                                        Property="BorderBrush"
                                        Value="#FF60CDFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <Border x:Name="SideDivider"
                    Width="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch"
                    Background="#66FFFFFF"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" />

            <StackPanel Margin="10"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top">
                <Border Padding="3"
                        HorizontalAlignment="Right"
                        Background="#E61A1A1A"
                        BorderBrush="#40FFFFFF"
                        BorderThickness="1"
                        CornerRadius="10">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="SplitModeButton"
                                     AutomationProperties.AutomationId="PreviewModeSplit"
                                     AutomationProperties.Name="{Binding Localization[previewModeSplit], ElementName=Root}"
                                     Checked="OnPreviewModeChecked"
                                     GroupName="PreviewModes"
                                     IsChecked="True"
                                     AutomationProperties.HelpText="{Binding Localization[previewModeSplitTip], ElementName=Root}"
                                     Style="{StaticResource PreviewModeButton}"
                                     Tag="Split"
                                     ToolTip="{Binding Localization[previewModeSplitTip], ElementName=Root}">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="18" Height="18">
                                    <Rectangle Canvas.Left="2"
                                               Canvas.Top="3"
                                               Width="14"
                                               Height="12"
                                               Fill="#1FF2F2F2"
                                               RadiusX="2.5"
                                               RadiusY="2.5"
                                               Stroke="#FFF2F2F2"
                                               StrokeThickness="1.2" />
                                    <Rectangle Canvas.Left="2.6"
                                               Canvas.Top="3.6"
                                               Width="5.8"
                                               Height="10.8"
                                               Fill="#73F2F2F2"
                                               RadiusX="1.6"
                                               RadiusY="1.6" />
                                    <Path Data="M9,3 V15"
                                          Stroke="#FFF2F2F2"
                                          StrokeEndLineCap="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeThickness="1.2" />
                                </Canvas>
                            </Viewbox>
                        </RadioButton>
                        <RadioButton x:Name="SingleModeButton"
                                     AutomationProperties.AutomationId="PreviewModeSingle"
                                     AutomationProperties.Name="{Binding Localization[previewModeSingle], ElementName=Root}"
                                     Checked="OnPreviewModeChecked"
                                     GroupName="PreviewModes"
                                     AutomationProperties.HelpText="{Binding Localization[previewModeSingleTip], ElementName=Root}"
                                     Style="{StaticResource PreviewModeButton}"
                                     Tag="Single"
                                     ToolTip="{Binding Localization[previewModeSingleTip], ElementName=Root}">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="18" Height="18">
                                    <Rectangle Canvas.Left="2"
                                               Canvas.Top="3"
                                               Width="14"
                                               Height="12"
                                               Fill="#59F2F2F2"
                                               RadiusX="2.5"
                                               RadiusY="2.5"
                                               Stroke="#FFF2F2F2"
                                               StrokeThickness="1.2" />
                                </Canvas>
                            </Viewbox>
                        </RadioButton>
                        <RadioButton x:Name="SideBySideModeButton"
                                     AutomationProperties.AutomationId="PreviewModeSideBySide"
                                     AutomationProperties.Name="{Binding Localization[previewModeSideBySide], ElementName=Root}"
                                     Checked="OnPreviewModeChecked"
                                     GroupName="PreviewModes"
                                     AutomationProperties.HelpText="{Binding Localization[previewModeSideBySideTip], ElementName=Root}"
                                     Style="{StaticResource PreviewModeButton}"
                                     Tag="SideBySide"
                                     ToolTip="{Binding Localization[previewModeSideBySideTip], ElementName=Root}">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="18" Height="18">
                                    <Rectangle Canvas.Left="1.5"
                                               Canvas.Top="3"
                                               Width="6.6"
                                               Height="12"
                                               Fill="#59F2F2F2"
                                               RadiusX="2"
                                               RadiusY="2"
                                               Stroke="#FFF2F2F2"
                                               StrokeThickness="1.2" />
                                    <Rectangle Canvas.Left="9.9"
                                               Canvas.Top="3"
                                               Width="6.6"
                                               Height="12"
                                               Fill="#59F2F2F2"
                                               RadiusX="2"
                                               RadiusY="2"
                                               Stroke="#FFF2F2F2"
                                               StrokeThickness="1.2" />
                                </Canvas>
                            </Viewbox>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <Border Margin="0,6,0,0"
                        Padding="3"
                        Background="#E61A1A1A"
                        BorderBrush="#40FFFFFF"
                        BorderThickness="1"
                        CornerRadius="10">
                    <StackPanel Orientation="Horizontal">
                        <Button AutomationProperties.Name="{Binding Localization[beforeAfterZoomOut], ElementName=Root}"
                                Click="OnZoomOutClick"
                                Style="{StaticResource ZoomButton}"
                                ToolTip="{Binding Localization[beforeAfterZoomOutTip], ElementName=Root}">
                            <Viewbox Width="14" Height="14">
                                <Canvas Width="12" Height="12">
                                    <Path Data="M1,6 H11"
                                          Stroke="#FFF2F2F2"
                                          StrokeEndLineCap="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeThickness="1.5" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Border Width="1"
                                Height="18"
                                Margin="4,0"
                                VerticalAlignment="Center"
                                Background="#33FFFFFF" />
                        <Button Width="56"
                                AutomationProperties.Name="{Binding Localization[beforeAfterFit], ElementName=Root}"
                                Click="OnZoomResetClick"
                                IsEnabled="{Binding IsZoomed, ElementName=Root}"
                                Style="{StaticResource ZoomButton}"
                                ToolTip="{Binding Localization[beforeAfterFitTip], ElementName=Root}">
                            <TextBlock x:Name="ZoomText"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#FFF2F2F2"
                                       Text="100%" />
                        </Button>
                        <Border Width="1"
                                Height="18"
                                Margin="4,0"
                                VerticalAlignment="Center"
                                Background="#33FFFFFF" />
                        <Button AutomationProperties.Name="{Binding Localization[beforeAfterZoomIn], ElementName=Root}"
                                Click="OnZoomInClick"
                                Style="{StaticResource ZoomButton}"
                                ToolTip="{Binding Localization[beforeAfterZoomInTip], ElementName=Root}">
                            <Viewbox Width="14" Height="14">
                                <Canvas Width="12" Height="12">
                                    <Path Data="M1,6 H11 M6,1 V11"
                                          Stroke="#FFF2F2F2"
                                          StrokeEndLineCap="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeThickness="1.5" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <ContentPresenter Grid.Row="1"
                          Margin="10,8,10,8"
                          VerticalAlignment="Center"
                          Content="{Binding Footer, ElementName=Root}" />
    </Grid>
</UserControl>
