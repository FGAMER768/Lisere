<ui:FluentWindow x:Class="Lisere.Views.UninstallWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{Binding WindowTitle}"
                 Width="480"
                 Height="318"
                 MinWidth="440"
                 MinHeight="300"
                 ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen"
                 Background="{ui:ThemeResource ApplicationBackgroundBrush}"
                 Loaded="OnLoaded"
                 PreviewKeyDown="OnPreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="{Binding WindowTitle}"
                     ShowMaximize="False"
                     ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="28,12,28,0">
            <StackPanel Orientation="Horizontal">
                <Border Width="46"
                        Height="46"
                        VerticalAlignment="Top"
                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                        CornerRadius="11">
                    <ui:SymbolIcon HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="24"
                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                   Symbol="Delete24" />
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontSize="22"
                               FontWeight="SemiBold"
                               Text="{Binding Heading}" />
                    <TextBlock Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                               Text="{Binding Message}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

            <Border Margin="0,20,0,0"
                    Padding="14"
                    Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="7">
                <TextBlock FontSize="12"
                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                           Text="{Binding DataNote}"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <Border Grid.Row="2"
                Padding="24,14,24,20"
                BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:Button x:Name="CancelButton"
                           Grid.Column="1"
                           MinWidth="96"
                           Appearance="Secondary"
                           Click="OnCancelClick"
                           Content="{Binding CancelText}"
                           IsCancel="True" />
                <ui:Button x:Name="UninstallButton"
                           Grid.Column="2"
                           MinWidth="132"
                           Margin="10,0,0,0"
                           Appearance="Danger"
                           Click="OnUninstallClick"
                           Content="{Binding UninstallText}"
                           Icon="{ui:SymbolIcon Delete24}" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
