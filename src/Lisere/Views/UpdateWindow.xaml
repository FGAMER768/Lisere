<ui:FluentWindow x:Class="Lisere.Views.UpdateWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{Binding Strings[updateWindowTitle]}"
                 Icon="/Assets/Lisere.ico"
                 Width="560"
                 Height="400"
                 MinWidth="480"
                 MinHeight="380"
                 ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterOwner"
                 Background="{ui:ThemeResource ApplicationBackgroundBrush}"
                 Loaded="OnLoaded"
                 PreviewKeyDown="OnPreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="{Binding Strings[updateWindowTitle]}"
                     ShowMaximize="False"
                     ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon>
                    <ui:ImageIcon.Source>
                        <BitmapImage UriSource="pack://application:,,,/Assets/LisereIcon.png" />
                    </ui:ImageIcon.Source>
                </ui:ImageIcon>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,8,28,24">
                <StackPanel Orientation="Horizontal">
                    <Border Width="48"
                            Height="48"
                            VerticalAlignment="Top"
                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                            CornerRadius="12">
                        <ui:SymbolIcon HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="24"
                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                       Symbol="ArrowSync24" />
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="24"
                                   FontWeight="SemiBold"
                                   Text="{Binding Strings[updateHeading]}" />
                        <TextBlock Margin="0,3,0,0"
                                   FontSize="12"
                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{Binding CurrentVersionText}" />
                    </StackPanel>
                </StackPanel>

                <Border Margin="0,22,0,0" Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Margin="0,1,12,0"
                                       VerticalAlignment="Top"
                                       FontSize="20"
                                       Foreground="{ui:ThemeResource AccentTextFillColorPrimaryBrush}"
                                       Symbol="Info24" />
                        <StackPanel Grid.Column="1">
                            <TextBlock AutomationProperties.LiveSetting="Polite"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Text="{Binding StatusTitle}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,4,0,0"
                                       FontSize="12"
                                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{Binding StatusDetail}"
                                       TextWrapping="Wrap" />
                            <ProgressBar Margin="0,12,0,0"
                                         Height="4"
                                         AutomationProperties.Name="{Binding Strings[updateProgress]}"
                                         IsIndeterminate="{Binding IsIndeterminate}"
                                         Maximum="100"
                                         Minimum="0"
                                         Value="{Binding ProgressPercent}"
                                         Visibility="{Binding IsProgressVisible, Converter={StaticResource BooleanToVisibility}}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Margin="0,18,0,0"
                           FontSize="12"
                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                           Text="{Binding Strings[updateExplanation]}"
                           TextWrapping="Wrap" />

                <StackPanel Margin="0,22,0,0" Orientation="Horizontal">
                    <ui:Button x:Name="CheckButton"
                               MinWidth="132"
                               Appearance="Secondary"
                               Command="{Binding CheckCommand}"
                               Content="{Binding Strings[updateCheck]}"
                               Icon="{ui:SymbolIcon ArrowSync24}" />
                    <ui:Button Margin="8,0,0,0"
                               MinWidth="112"
                               Appearance="Primary"
                               Command="{Binding InstallCommand}"
                               Content="{Binding Strings[updateInstall]}"
                               Icon="{ui:SymbolIcon ArrowDownload24}" />
                </StackPanel>

                <Border Margin="0,20,0,0"
                        Padding="0,12,0,0"
                        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0">
                    <TextBlock FontSize="11"
                               Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                               Text="{Binding Strings[updateSecurityNote]}"
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
