<Window x:Class="Lisere.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:setup="clr-namespace:Lisere.Setup"
        Title="Installer Liseré"
        Width="680"
        Height="610"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SetupBackgroundBrush}"
        Icon="/Assets/Lisere.ico"
        PreviewKeyDown="OnPreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="SetupView"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,30,32,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Width="46"
                           Height="46"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Source="/Assets/LisereIcon.png"
                           Stretch="Uniform" />
                    <StackPanel Grid.Column="1" Margin="14,1,16,0">
                        <TextBlock x:Name="HeadingText"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   Text="Installer Liseré" />
                        <TextBlock x:Name="IntroText"
                                   Margin="0,4,0,0"
                                   FontSize="13"
                                   Foreground="{StaticResource SetupSecondaryTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Top"
                                Orientation="Horizontal">
                        <Button x:Name="FrenchButton"
                                Width="36"
                                Height="28"
                                MinWidth="0"
                                Padding="0"
                                AutomationProperties.Name="Français"
                                Click="OnFrenchClick"
                                Content="FR"
                                FontSize="11"
                                Style="{StaticResource SetupGhostButton}" />
                        <Button x:Name="EnglishButton"
                                Width="36"
                                Height="28"
                                MinWidth="0"
                                Padding="0"
                                AutomationProperties.Name="English"
                                Click="OnEnglishClick"
                                Content="EN"
                                FontSize="11"
                                Style="{StaticResource SetupGhostButton}" />
                    </StackPanel>
                </Grid>

                <Border Margin="0,24,0,0"
                        Padding="18"
                        Background="{StaticResource SetupCardBrush}"
                        BorderBrush="{StaticResource SetupBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock x:Name="DestinationLabel"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Text="Dossier d'installation" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DestinationBox"
                                     VerticalContentAlignment="Center" />
                            <Button x:Name="BrowseButton"
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    MinWidth="112"
                                    Click="OnBrowseClick"
                                    Content="Parcourir..."
                                    Style="{StaticResource SetupSecondaryButton}" />
                        </Grid>
                        <TextBlock x:Name="DestinationNote"
                                   Margin="0,10,0,0"
                                   FontSize="11"
                                   Foreground="{StaticResource SetupSecondaryTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <CheckBox x:Name="DesktopShortcutCheck"
                          Margin="2,16,0,0"
                          Content="Créer un raccourci sur le Bureau" />

                <Border x:Name="StatusCard"
                        Margin="0,20,0,0"
                        Padding="16"
                        Background="#FF202020"
                        BorderBrush="{StaticResource SetupBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="StatusIconBorder"
                                Width="30"
                                Height="30"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="#FF2D2D2D"
                                CornerRadius="15">
                            <setup:FluentIcon x:Name="StatusGlyph"
                                              FontSize="17"
                                              Foreground="{StaticResource SetupAccentBrush}"
                                              Symbol="Info24" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="StatusTitle"
                                       AutomationProperties.LiveSetting="Polite"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Text="Prêt à installer" />
                            <TextBlock x:Name="StatusDetail"
                                       MinHeight="32"
                                       Margin="0,3,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource SetupSecondaryTextBrush}"
                                       TextWrapping="Wrap" />
                            <ProgressBar x:Name="Progress"
                                         Margin="0,12,0,0"
                                         Maximum="100"
                                         Minimum="0"
                                         Visibility="Hidden" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock x:Name="SecurityNote"
                           Margin="0,16,2,0"
                           FontSize="11"
                           Foreground="{StaticResource SetupSecondaryTextBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="FinishView"
              Margin="40,20,40,20"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center">
                <Border Width="72"
                        Height="72"
                        HorizontalAlignment="Center"
                        Background="#FF1C3A2A"
                        CornerRadius="36">
                    <setup:FluentIcon FontSize="40"
                                      Foreground="#FF77E39B"
                                      Symbol="Checkmark48" />
                </Border>
                <TextBlock x:Name="FinishTitle"
                           Margin="0,18,0,0"
                           HorizontalAlignment="Center"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Text="Installation terminée" />
                <TextBlock x:Name="FinishDetail"
                           Margin="0,6,0,0"
                           MaxWidth="430"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           Foreground="{StaticResource SetupSecondaryTextBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="FinishPath"
                           Margin="0,14,0,0"
                           MaxWidth="500"
                           HorizontalAlignment="Center"
                           FontSize="11"
                           Foreground="{StaticResource SetupSecondaryTextBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Padding="28,14,28,18"
                Background="#FF191919"
                BorderBrush="{StaticResource SetupBorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="VersionLabel"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{StaticResource SetupSecondaryTextBrush}"
                           Text="Version 1.0.0" />
                <Button x:Name="CancelButton"
                        Grid.Column="1"
                        MinWidth="96"
                        Click="OnCancelClick"
                        Content="Annuler"
                        IsCancel="True"
                        Style="{StaticResource SetupSecondaryButton}" />
                <Button x:Name="InstallButton"
                        Grid.Column="2"
                        Margin="10,0,0,0"
                        MinWidth="132"
                        Click="OnInstallClick"
                        Content="Installer"
                        IsDefault="True"
                        Style="{StaticResource SetupPrimaryButton}" />
            </Grid>
        </Border>
    </Grid>
</Window>
