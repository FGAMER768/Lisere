<UserControl x:Class="Lisere.Views.Dialogs.WaitDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root"
             Focusable="True">

    <Grid x:Name="RootGrid" Background="#99000000">
        <Border x:Name="DialogCard"
                MinWidth="340"
                MaxWidth="440"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#FF272727"
                BorderBrush="#FF3A3A3A"
                BorderThickness="1"
                CornerRadius="8"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="24,24,24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Grid.Column="0"
                                   Symbol="Clock16"
                                   Foreground="#FFD0D0D0"
                                   FontSize="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    <TextBlock x:Name="TitleText"
                               Grid.Column="2"
                               Text=""
                               Foreground="#FFD0D0D0"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </Grid>

                <Grid Grid.Row="1"
                      MinHeight="56"
                      Margin="24,18,24,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:ProgressRing Grid.Column="0"
                                     Width="28"
                                     Height="28"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     IsIndeterminate="True" />
                    <TextBlock x:Name="MessageText"
                               Grid.Column="2"
                               AutomationProperties.LiveSetting="Polite"
                               Foreground="#FFE6E6E6"
                               FontSize="14"
                               Text="Chargement..."
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
