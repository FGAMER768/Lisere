<UserControl x:Class="Lisere.Views.VideoPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:Lisere.Views">

    <Grid Margin="20">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,8,0" FontSize="18" Symbol="Video24" />
                                <TextBlock FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="{Binding Strings[videoPreviewTitle]}" />
                            </StackPanel>
                            <TextBlock Margin="26,2,0,0"
                                       FontSize="11"
                                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{Binding ToolchainStatusText}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Margin="12,0,0,0"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{Binding VideoInfoText}"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasVideo}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ui:ProgressRing Grid.Column="2"
                                         Width="16"
                                         Height="16"
                                         Margin="12,0,0,0"
                                         VerticalAlignment="Center"
                                         AutomationProperties.Name="{Binding Strings[videoProcessing]}"
                                         IsIndeterminate="True"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}" />
                        <ui:Button Grid.Column="3"
                                   Margin="12,0,0,0"
                                   Appearance="Secondary"
                                   Command="{Binding CancelBusyCommand}"
                                   Content="{Binding Strings[actionCancel]}"
                                   Icon="{ui:SymbolIcon Stop24}"
                                   Visibility="{Binding IsCancellableBusy, Converter={StaticResource BooleanToVisibility}}" />
                        <ui:Button Grid.Column="4"
                                   Margin="12,0,0,0"
                                   AutomationProperties.AcceleratorKey="Ctrl+O"
                                   Appearance="Secondary"
                                   Command="{Binding OpenCommand}"
                                   Content="{Binding Strings[pageOpen]}"
                                   Icon="{ui:SymbolIcon Open24}" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <views:BeforeAfterView AfterImage="{Binding AfterImage}"
                                               BeforeImage="{Binding BeforeImage}"
                                               ComparisonPosition="{Binding ComparisonPosition, Mode=TwoWay}"
                                               Localization="{Binding Strings}"
                                               Visibility="{Binding HasVideo, Converter={StaticResource BooleanToVisibility}}" />

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasVideo}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <ui:SymbolIcon HorizontalAlignment="Center"
                                           FontSize="48"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                           Symbol="Video24" />
                            <TextBlock Margin="0,12,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Text="{Binding Strings[videoEmptyTitle]}" />
                            <TextBlock Margin="0,4,0,0"
                                       MaxWidth="420"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{Binding Strings[videoEmptyBody]}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                            <ui:Button Margin="0,16,0,0"
                                       HorizontalAlignment="Center"
                                       AutomationProperties.AcceleratorKey="Ctrl+O"
                                       Appearance="Primary"
                                       Command="{Binding OpenCommand}"
                                       Content="{Binding Strings[videoOpenAction]}"
                                       Icon="{ui:SymbolIcon Open24}" />
                            <TextBlock Margin="0,12,0,0"
                                       MaxWidth="460"
                                       HorizontalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{Binding ToolchainNote}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,18,0">
                        <Border Style="{StaticResource SettingsCardBorder}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Strings[videoSectionModel]}" />

                                <TextBlock Margin="0,0,0,4"
                                           FontSize="12"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                           Text="{Binding Strings[videoLabelEngine]}" />
                                <ComboBox AutomationProperties.Name="{Binding Strings[videoLabelEngine]}"
                                          DisplayMemberPath="DisplayName"
                                          ItemsSource="{Binding Engines}"
                                          SelectedItem="{Binding SelectedEngine, Mode=TwoWay}" />
                                <TextBlock Margin="0,6,0,0"
                                           FontSize="12"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                           Text="{Binding EngineNote}"
                                           TextWrapping="Wrap" />

                                <TextBlock Margin="0,12,0,4"
                                           FontSize="12"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                           Text="{Binding Strings[sectionPreset]}" />
                                <ComboBox AutomationProperties.Name="{Binding Strings[sectionPreset]}"
                                          DisplayMemberPath="Label"
                                          ItemsSource="{Binding Presets}"
                                          SelectedItem="{Binding SelectedPreset, Mode=TwoWay}" />

                                <ui:Button Margin="0,8,0,0"
                                           HorizontalAlignment="Stretch"
                                           HorizontalContentAlignment="Center"
                                           Appearance="Secondary"
                                           Command="{Binding ImportVideoPresetCommand}"
                                           Content="{Binding Strings[videoActionImportPreset]}" />

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource ParameterLabel}" Text="{Binding Strings[videoLabelResolution]}" />
                                    <ComboBox Grid.Column="1"
                                              AutomationProperties.Name="{Binding Strings[videoLabelResolution]}"
                                              DisplayMemberPath="Label"
                                              ItemsSource="{Binding OutputOptions}"
                                              SelectedItem="{Binding SelectedOutput, Mode=TwoWay}" />
                                </Grid>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource ParameterLabel}" Text="{Binding Strings[videoLabelPreviewPosition]}" />
                                    <TextBlock Grid.Column="1"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                               Text="{Binding PreviewPositionPercent, StringFormat={}{0:0}%}" />
                                </Grid>
                                <Slider AutomationProperties.Name="{Binding Strings[videoLabelPreviewPosition]}"
                                        IsSnapToTickEnabled="True"
                                        Maximum="95"
                                        Minimum="0"
                                        Style="{StaticResource ParameterSlider}"
                                        TickFrequency="1"
                                        Value="{Binding PreviewPositionPercent, Mode=TwoWay}" />
                                <ui:Button Margin="0,8,0,0"
                                           HorizontalAlignment="Stretch"
                                           HorizontalContentAlignment="Center"
                                           AutomationProperties.AcceleratorKey="Ctrl+Entrée"
                                           Appearance="Secondary"
                                           Command="{Binding RefreshPreviewCommand}"
                                           Content="{Binding Strings[videoActionPreview]}"
                                           Icon="{ui:SymbolIcon Eye24}" />
                                <ui:Button Margin="0,6,0,0"
                                           HorizontalAlignment="Stretch"
                                           HorizontalContentAlignment="Center"
                                           Appearance="Secondary"
                                           Command="{Binding RenderPreviewCommand}"
                                           Content="{Binding Strings[videoPreviewRender]}"
                                           Icon="{ui:SymbolIcon Play24}" />
                                <ui:Button Margin="0,6,0,0"
                                           HorizontalAlignment="Stretch"
                                           HorizontalContentAlignment="Center"
                                           Appearance="Secondary"
                                           Command="{Binding ExportPreviewCommand}"
                                           Content="{Binding Strings[videoPreviewExport]}"
                                           Icon="{ui:SymbolIcon Save24}" />
                                <TextBlock Margin="0,6,0,0"
                                           FontSize="12"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                           Text="{Binding PreviewEstimateText}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding HasEstimate, Converter={StaticResource BooleanToVisibility}}" />
                            </StackPanel>
                        </Border>

                        <ui:InfoBar Margin="0,12,0,0"
                                    AutomationProperties.LiveSetting="Assertive"
                                    IsClosable="False"
                                    IsOpen="{Binding HasError, Mode=OneWay}"
                                    Message="{Binding ErrorMessage}"
                                    Severity="Error"
                                    Title="{Binding Strings[errorBarTitle]}" />

                        <ui:InfoBar Margin="0,12,0,0"
                                    IsClosable="False"
                                    IsOpen="{Binding HasWarnings, Mode=OneWay}"
                                    Message="{Binding WarningsText}"
                                    Severity="Warning"
                                    Title="{Binding Strings[dialogWarningTitle]}" />

                        <Border Margin="0,12,0,0" Style="{StaticResource SettingsCardBorder}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Strings[sectionSettings]}" />

                                <Grid Style="{StaticResource ParameterGroup}" Margin="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="104" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource ParameterLabel}" Text="{Binding Strings[paramFixCompression]}" />
                                    <ui:NumberBox Grid.Column="1"
                                                  Style="{StaticResource ParameterNumberBox}"
                                                  AutomationProperties.Name="{Binding Strings[paramFixCompression]}"
                                                  AcceptsExpression="False"
                                                  MaxDecimalPlaces="1"
                                                  Maximum="{Binding ParameterMaximum}"
                                                  Minimum="{Binding ParameterMinimum}"
                                                  SmallChange="1"
                                                  Value="{Binding FixCompression, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Slider AutomationProperties.Name="{Binding Strings[paramFixCompression]}"
                                        Maximum="{Binding ParameterMaximum}"
                                        Minimum="{Binding ParameterMinimum}"
                                        Style="{StaticResource ParameterSlider}"
                                        TickFrequency="1"
                                        Value="{Binding FixCompression, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <Grid Style="{StaticResource ParameterGroup}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="104" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource ParameterLabel}" Text="{Binding Strings[paramReduceNoise]}" />
                                    <ui:NumberBox Grid.Column="1"
                                                  Style="{StaticResource ParameterNumberBox}"
                                                  AutomationProperties.Name="{Binding Strings[paramReduceNoise]}"
                                                  AcceptsExpression="False"
                                                  MaxDecimalPlaces="1"
                                                  Maximum="{Binding ParameterMaximum}"
                                                  Minimum="{Binding ParameterMinimum}"
                                                  SmallChange="1"
                                                  Value="{Binding ReduceNoise, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Slider AutomationProperties.Name="{Binding Strings[paramReduceNoise]}"
                                        Maximum="{Binding ParameterMaximum}"
                                        Minimum="{Binding ParameterMinimum}"
                                        Style="{StaticResource ParameterSlider}"
                                        TickFrequency="1"
                                        Value="{Binding ReduceNoise, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <Grid Style="{StaticResource ParameterGroup}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="104" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource ParameterLabel}" Text="{Binding Strings[paramSharpen]}" />
                                    <ui:NumberBox Grid.Column="1"
                                                  Style="{StaticResource ParameterNumberBox}"
                                                  AutomationProperties.Name="{Binding Strings[paramSharpen]}"
                                                  AcceptsExpression="False"
                                                  MaxDecimalPlaces="1"
                                                  Maximum="{Binding ParameterMaximum}"
                                                  Minimum="{Binding ParameterMinimum}"
                                                  SmallChange="1"
                                                  Value="{Binding Sharpen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Slider AutomationProperties.Name="{Binding Strings[paramSharpen]}"
                                        Maximum="{Binding ParameterMaximum}"
                                        Minimum="{Binding ParameterMinimum}"
                                        Style="{StaticResource ParameterSlider}"
                                        TickFrequency="1"
                                        Value="{Binding Sharpen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <Grid Style="{StaticResource ParameterGroup}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="104" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource ParameterLabel}" Text="{Binding Strings[paramRecoverDetails]}" />
                                    <ui:NumberBox Grid.Column="1"
                                                  Style="{StaticResource ParameterNumberBox}"
                                                  AutomationProperties.Name="{Binding Strings[paramRecoverDetails]}"
                                                  AcceptsExpression="False"
                                                  MaxDecimalPlaces="1"
                                                  Maximum="{Binding ParameterMaximum}"
                                                  Minimum="{Binding ParameterMinimum}"
                                                  SmallChange="1"
                                                  Value="{Binding RecoverDetails, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Slider AutomationProperties.Name="{Binding Strings[paramRecoverDetails]}"
                                        Maximum="{Binding ParameterMaximum}"
                                        Minimum="{Binding ParameterMinimum}"
                                        Style="{StaticResource ParameterSlider}"
                                        TickFrequency="1"
                                        Value="{Binding RecoverDetails, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <Grid Style="{StaticResource ParameterGroup}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="104" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource ParameterLabel}" Text="{Binding Strings[paramDehalo]}" />
                                    <ui:NumberBox Grid.Column="1"
                                                  Style="{StaticResource ParameterNumberBox}"
                                                  AutomationProperties.Name="{Binding Strings[paramDehalo]}"
                                                  AcceptsExpression="False"
                                                  MaxDecimalPlaces="1"
                                                  Maximum="{Binding ParameterMaximum}"
                                                  Minimum="{Binding ParameterMinimum}"
                                                  SmallChange="1"
                                                  Value="{Binding Dehalo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Slider AutomationProperties.Name="{Binding Strings[paramDehalo]}"
                                        Maximum="{Binding ParameterMaximum}"
                                        Minimum="{Binding ParameterMinimum}"
                                        Style="{StaticResource ParameterSlider}"
                                        TickFrequency="1"
                                        Value="{Binding Dehalo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <Grid Style="{StaticResource ParameterGroup}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="104" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource ParameterLabel}" Text="{Binding Strings[paramAntialias]}" />
                                    <ui:NumberBox Grid.Column="1"
                                                  Style="{StaticResource ParameterNumberBox}"
                                                  AutomationProperties.Name="{Binding Strings[paramAntialias]}"
                                                  AcceptsExpression="False"
                                                  MaxDecimalPlaces="1"
                                                  Maximum="{Binding ParameterMaximum}"
                                                  Minimum="{Binding AntialiasMinimum}"
                                                  SmallChange="1"
                                                  Value="{Binding AntialiasDeblur, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Slider AutomationProperties.Name="{Binding Strings[paramAntialias]}"
                                        Maximum="{Binding ParameterMaximum}"
                                        Minimum="{Binding AntialiasMinimum}"
                                        Style="{StaticResource ParameterSlider}"
                                        TickFrequency="1"
                                        Value="{Binding AntialiasDeblur, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <Border Height="1"
                                        Margin="0,14"
                                        Background="{ui:ThemeResource CardStrokeColorDefaultBrush}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="104" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource ParameterLabel}" Text="{Binding Strings[paramOriginalDetail]}" />
                                    <ui:NumberBox Grid.Column="1"
                                                  Style="{StaticResource ParameterNumberBox}"
                                                  AutomationProperties.Name="{Binding Strings[paramOriginalDetail]}"
                                                  AcceptsExpression="False"
                                                  MaxDecimalPlaces="1"
                                                  Maximum="{Binding ParameterMaximum}"
                                                  Minimum="{Binding ParameterMinimum}"
                                                  SmallChange="1"
                                                  Value="{Binding RecoverOriginalDetail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Slider AutomationProperties.Name="{Binding Strings[paramOriginalDetail]}"
                                        Maximum="{Binding ParameterMaximum}"
                                        Minimum="{Binding ParameterMinimum}"
                                        Style="{StaticResource ParameterSlider}"
                                        TickFrequency="1"
                                        Value="{Binding RecoverOriginalDetail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <Grid Style="{StaticResource ParameterGroup}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="104" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource ParameterLabel}" Text="{Binding Strings[paramAddNoise]}" />
                                    <ui:NumberBox Grid.Column="1"
                                                  Style="{StaticResource ParameterNumberBox}"
                                                  AutomationProperties.Name="{Binding Strings[paramAddNoise]}"
                                                  AcceptsExpression="False"
                                                  MaxDecimalPlaces="3"
                                                  Maximum="{Binding NoiseMaximum}"
                                                  Minimum="{Binding ParameterMinimum}"
                                                  SmallChange="0.005"
                                                  Value="{Binding AddNoise, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Slider AutomationProperties.Name="{Binding Strings[paramAddNoise]}"
                                        Maximum="{Binding NoiseMaximum}"
                                        Minimum="{Binding ParameterMinimum}"
                                        SmallChange="0.005"
                                        Style="{StaticResource ParameterSlider}"
                                        TickFrequency="0.005"
                                        Value="{Binding AddNoise, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0" Style="{StaticResource SettingsCardBorder}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Strings[videoSectionColor]}" />
                                <ComboBox AutomationProperties.Name="{Binding Strings[videoSectionColor]}"
                                          DisplayMemberPath="Label"
                                          ItemsSource="{Binding ColorPresets}"
                                          SelectedItem="{Binding SelectedColorPreset, Mode=TwoWay}" />
                                <TextBlock Margin="0,6,0,0"
                                           FontSize="12"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                           Text="{Binding Strings[videoColorNote]}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0" Style="{StaticResource SettingsCardBorder}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Strings[videoSectionOutput]}" />

                                <ui:ToggleSwitch AutomationProperties.Name="{Binding Strings[videoStabilize]}"
                                                 Content="{Binding Strings[videoStabilize]}"
                                                 IsChecked="{Binding Stabilize, Mode=TwoWay}" />
                                <TextBlock Margin="0,2,0,0"
                                           FontSize="12"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                           Text="{Binding Strings[videoStabilizeNote]}"
                                           TextWrapping="Wrap" />

                                <ui:ToggleSwitch Margin="0,10,0,0"
                                                 AutomationProperties.Name="{Binding Strings[videoDeinterlace]}"
                                                 Content="{Binding Strings[videoDeinterlace]}"
                                                 IsChecked="{Binding Deinterlace, Mode=TwoWay}" />
                                <TextBlock Margin="0,2,0,0"
                                           FontSize="12"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                           Text="{Binding Strings[videoDeinterlaceNote]}"
                                           TextWrapping="Wrap" />

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource ParameterLabel}" Text="{Binding Strings[videoLabelFrameRate]}" />
                                    <ComboBox Grid.Column="1"
                                              AutomationProperties.Name="{Binding Strings[videoLabelFrameRate]}"
                                              DisplayMemberPath="Label"
                                              IsEnabled="{Binding CanChooseFrameRate}"
                                              ItemsSource="{Binding FrameRates}"
                                              SelectedItem="{Binding SelectedFrameRate, Mode=TwoWay}" />
                                </Grid>
                                <TextBlock Margin="0,2,0,0"
                                           FontSize="12"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                           Text="{Binding Strings[videoFrameRateNote]}"
                                           TextWrapping="Wrap" />

                                <ui:ToggleSwitch Margin="0,10,0,0"
                                                 AutomationProperties.Name="{Binding Strings[videoRife]}"
                                                 Content="{Binding Strings[videoRife]}"
                                                 IsChecked="{Binding UseRife, Mode=TwoWay}"
                                                 IsEnabled="{Binding IsRifeAvailable}" />
                                <TextBlock Margin="0,2,0,0"
                                           FontSize="12"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                           Text="{Binding RifeNote}"
                                           TextWrapping="Wrap" />

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource ParameterLabel}" Text="{Binding Strings[videoCodec]}" />
                                    <ComboBox Grid.Column="1"
                                              AutomationProperties.Name="{Binding Strings[videoCodec]}"
                                              DisplayMemberPath="Label"
                                              ItemsSource="{Binding Codecs}"
                                              SelectedItem="{Binding SelectedCodec, Mode=TwoWay}" />
                                </Grid>

                                <Grid Style="{StaticResource ParameterGroup}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="104" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource ParameterLabel}" Text="{Binding Strings[videoQuality]}" />
                                    <ui:NumberBox Grid.Column="1"
                                                  Style="{StaticResource ParameterNumberBox}"
                                                  AutomationProperties.Name="{Binding Strings[videoQuality]}"
                                                  AcceptsExpression="False"
                                                  Maximum="32"
                                                  Minimum="14"
                                                  SmallChange="1"
                                                  Value="{Binding Quality, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Slider AutomationProperties.Name="{Binding Strings[videoQuality]}"
                                        IsSnapToTickEnabled="True"
                                        Maximum="32"
                                        Minimum="14"
                                        Style="{StaticResource ParameterSlider}"
                                        TickFrequency="1"
                                        Value="{Binding Quality, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,2,0,0"
                                           FontSize="12"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                           Text="{Binding Strings[videoQualityNote]}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0" Style="{StaticResource SettingsCardBorder}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Strings[videoSectionQueue]}" />

                                <TextBlock Margin="0,0,0,4"
                                           FontSize="12"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                           Text="{Binding Strings[videoQueueEmpty]}"
                                           TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasQueue}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <ItemsControl ItemsSource="{Binding Queue}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock FontSize="12"
                                                               Text="{Binding Label}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <ProgressBar Height="3"
                                                                 Margin="0,4,0,0"
                                                                 Maximum="100"
                                                                 Value="{Binding ProgressPercent}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Margin="8,0,0,0"
                                                           VerticalAlignment="Top"
                                                           FontSize="11"
                                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                                           Text="{Binding StatusText}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ui:Button Margin="0,8,0,0"
                                           HorizontalAlignment="Stretch"
                                           HorizontalContentAlignment="Center"
                                           Appearance="Secondary"
                                           Command="{Binding AddToQueueCommand}"
                                           Content="{Binding Strings[videoActionAddQueue]}" />

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:Button Grid.Column="0"
                                               HorizontalAlignment="Stretch"
                                               HorizontalContentAlignment="Center"
                                               Appearance="Primary"
                                               Command="{Binding RunQueueCommand}"
                                               Content="{Binding Strings[videoActionRunQueue]}" />
                                    <ui:Button Grid.Column="2"
                                               HorizontalAlignment="Stretch"
                                               HorizontalContentAlignment="Center"
                                               Appearance="Secondary"
                                               Command="{Binding StopQueueCommand}"
                                               Content="{Binding Strings[videoActionStopQueue]}" />
                                </Grid>

                                <ui:Button Margin="0,8,0,0"
                                           HorizontalAlignment="Stretch"
                                           HorizontalContentAlignment="Center"
                                           Appearance="Secondary"
                                           Command="{Binding ClearQueueCommand}"
                                           Content="{Binding Strings[videoActionClearQueue]}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="1" Margin="0,12,18,0" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,6"
                                   FontSize="12"
                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{Binding EstimateText}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasEstimate, Converter={StaticResource BooleanToVisibility}}" />
                        <ui:Button HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Center"
                                   AutomationProperties.AcceleratorKey="Ctrl+S"
                                   Appearance="Primary"
                                   Command="{Binding RenderCommand}"
                                   Content="{Binding Strings[videoActionRender]}"
                                   Icon="{ui:SymbolIcon Save24}" />
                        <ui:Button Margin="0,8,0,0"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Center"
                                   Command="{Binding CancelRenderCommand}"
                                   Content="{Binding Strings[videoActionCancel]}"
                                   Icon="{ui:SymbolIcon Stop24}"
                                   Visibility="{Binding IsRendering, Converter={StaticResource BooleanToVisibility}}" />
                        <ProgressBar Height="4"
                                     Margin="0,10,0,0"
                                     Maximum="100"
                                     Value="{Binding ProgressPercent}"
                                     Visibility="{Binding IsRendering, Converter={StaticResource BooleanToVisibility}}" />
                        <TextBlock Margin="0,6,0,0"
                                   FontSize="12"
                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{Binding ProgressText}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="12"
                                   Foreground="{ui:ThemeResource AccentTextFillColorPrimaryBrush}"
                                   Text="{Binding ProgressHint}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasProgressHint, Converter={StaticResource BooleanToVisibility}}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

    </Grid>
</UserControl>
